#==================================================================
#  PT. Sumatera Andalan Haramain — Sistem Transaksi Terintegrasi
#  Salin menjadi .env lalu jalankan: php artisan key:generate
#==================================================================
APP_NAME="Sumatera Andalan Haramain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://sah-umrah.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

#---------------- Database (MySQL / MariaDB) ----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sah_umrah_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false   # true di produksi (HTTPS)
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
CACHE_STORE=database
# Antrean untuk email & WhatsApp otomatis — jalankan: php artisan queue:work
QUEUE_CONNECTION=database

#---------------- Penyimpanan file ----------------
FILESYSTEM_DISK=local
# Dokumen jamaah (privat & terenkripsi). Produksi: s3 (AWS S3 / Supabase Storage S3-compatible)
PRIVATE_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Supabase Storage contoh:
# AWS_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# AWS_USE_PATH_STYLE_ENDPOINT=true

#---------------- Email (SMTP / Resend / SendGrid) ----------------
# Lokal: log (lihat storage/logs/laravel.log) atau Herd Mail (smtp 127.0.0.1:2525)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sumateraandalanharamain.co.id"
MAIL_FROM_NAME="${APP_NAME}"
# Resend: MAIL_MAILER=resend + RESEND_KEY=re_xxx
RESEND_KEY=
# SendGrid via SMTP: MAIL_HOST=smtp.sendgrid.net MAIL_PORT=587 MAIL_USERNAME=apikey MAIL_PASSWORD=SG.xxx

#---------------- Payment Gateway ----------------
# simulator = lokal tanpa kunci (ada tombol "Simulasikan Pembayaran")
# xendit    = sandbox (secret key xnd_development_...) / produksi (xnd_production_...)
PAYMENT_GATEWAY=simulator
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard Xendit > Settings > Webhooks > "Verification token"
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_BANK_MANDIRI=MANDIRI
XENDIT_BANK_BSI=BSI
XENDIT_BANK_MUAMALAT=MUAMALAT
PAYMENT_SIMULATOR_SECRET=ganti-dengan-string-acak

PAYMENT_EXPIRY_HOURS=24
SEAT_HOLD_HOURS=24
FLIGHT_HOLD_HOURS=3
DEPOSIT_PER_PAX=true
MIN_INSTALLMENT_AMOUNT=500000
SETTLEMENT_DAYS_BEFORE_DEPARTURE=40

#---------------- Login Google (opsional) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

#---------------- WhatsApp otomatis (HANYA pengingat) ----------------
# Kosongkan token = pesan hanya dicatat di log (mode simulasi)
WHATSAPP_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_TOKEN=

#---------------- Keamanan data keuangan (app/Security/Finance) ----------------
# Email pemilik penerima peringatan perubahan rekening — TIDAK dapat diubah dari web
FINANCE_OWNER_EMAIL=pemilik.sah@gmail.com
# Buat dengan: php -r "echo bin2hex(random_bytes(32));"
FINANCE_INTEGRITY_KEY=
FINANCE_APPROVAL_HOURS=24

#---------------- Seeder ----------------
SEED_SUPERADMIN_EMAIL=superadmin@sah.co.id
SEED_ADMIN_EMAIL=admin@sah.co.id
SEED_ADMIN_PASSWORD="Admin#SAH2026"

VITE_APP_NAME="${APP_NAME}"
